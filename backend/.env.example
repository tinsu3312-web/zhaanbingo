PORT=3000
# Set this before exposing the admin endpoints outside your local computer.
ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional local-development timing overrides
# BUY_SECONDS=20
# CALL_INTERVAL_MS=5000
# Set to false to keep every finished game on screen until an admin starts a new round.
# AUTO_RESTART_AFTER_WIN=true
